# Supabase project URL and anon key (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# VAPID public key for Web Push (PWA notifications)
# Generate a pair with:  npx web-push@latest generate-vapid-keys
# The PRIVATE key goes in the send-push Edge Function secrets.
# See PUSH_SETUP.md for the full setup guide.
VITE_VAPID_PUBLIC_KEY=<your-vapid-public-key>
