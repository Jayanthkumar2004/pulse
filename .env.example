# Supabase project URL and anon key (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# OneSignal App ID for Web Push notifications
# Found in OneSignal Dashboard → Settings → Keys & IDs → OneSignal App ID.
# The OneSignal SDK script and service worker are already wired up in
# index.html and public/OneSignalSDKWorker.js.
VITE_ONESIGNAL_APP_ID=<your-onesignal-app-id>
